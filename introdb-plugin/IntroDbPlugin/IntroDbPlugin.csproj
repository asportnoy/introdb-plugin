<Project Sdk="Microsoft.NET.Sdk">
  <!-- JellyfinVersion and TargetFramework are set in Directory.Build.props (default: 12.2). -->

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion).*-*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion).*-*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Jellyfin 10.11+ moved MediaSegmentType into Jellyfin.Database.Implementations -->
  <ItemGroup Condition="'$(JellyfinVersion)' != '10.10'">
    <PackageReference Include="Jellyfin.Database.Implementations" Version="$(JellyfinVersion).*-*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IntroDbPlugin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>
</Project>
